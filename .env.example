# ─── Inspire 3D — variáveis de ambiente ───────────────────────────────
# Copie para .env.local e preencha conforme cada fase for ativada.

# Público
NEXT_PUBLIC_SITE_URL="https://www.inspire3d.com.br"
NEXT_PUBLIC_WHATSAPP="5531999700539"

# ─── Fase 2 — Orçamento inteligente ──────────────────────────────────
# Para onde chegam os leads do formulário. Se ficar vazio, usa o e-mail
# de contato definido em src/config/site.ts.
QUOTE_NOTIFICATION_EMAIL=""

# Remetente. Em produção use um domínio verificado na Resend
# (ex.: "Inspire 3D <orcamento@inspire3d.com.br>").
QUOTE_FROM_EMAIL=""

# Chave da Resend (resend.com). SEM ela o formulário continua funcionando,
# mas o lead só aparece no log do servidor — não chega no seu e-mail.
RESEND_API_KEY=""

# Fase 3 — Banco de dados (produtos, projetos, orçamentos)
DATABASE_URL=""

# ─── Inspire AI (agente de conversa) ─────────────────────────────────
# Chave da API Anthropic (console.anthropic.com). SEM ela o site continua
# funcionando: a aba de conversa simplesmente não aparece e o orçamento
# segue pelo formulário.
ANTHROPIC_API_KEY=""

# Modelo. claude-sonnet-5 é o equilíbrio recomendado para chat com cliente.
# Para baratear, claude-haiku-4-5-20251001 costuma dar conta deste fluxo.
INSPIRE_AI_MODEL="claude-sonnet-5"

# Fase 5 — E-commerce
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
