# ─── Inspire 3D — variáveis de ambiente ───────────────────────────────
# Copie para .env.local e preencha conforme cada fase for ativada.

# Público
NEXT_PUBLIC_SITE_URL="https://www.3dinspire.com.br"
NEXT_PUBLIC_WHATSAPP="5531999700539"
# Preencha somente depois de criar e testar esta caixa postal.
NEXT_PUBLIC_CONTACT_EMAIL=""

# ─── Fase 2 — Orçamento inteligente ──────────────────────────────────
# Para onde chegam os leads do formulário. Se ficar vazio, usa o e-mail
# de contato configurado em NEXT_PUBLIC_CONTACT_EMAIL.
QUOTE_NOTIFICATION_EMAIL=""

# Remetente. Em produção use um domínio verificado na Resend
# (ex.: "Inspire 3D <orcamento@3dinspire.com.br>").
QUOTE_FROM_EMAIL=""

# Chave da Resend (resend.com). Sem ela o envio automático falha e o pedido
# não fica salvo; o visitante deve encaminhar o briefing pelo WhatsApp.
RESEND_API_KEY=""

# Deixe DATABASE_URL vazio para usar o PostgreSQL embutido local (PGlite).
# Preencha com uma URL PostgreSQL quando o site for para um servidor externo.
DATABASE_URL=""
PGLITE_DATA_DIR=".data/inspire3d"
# Defina true somente se o PostgreSQL remoto exigir conexão SSL.
DATABASE_SSL="false"

# ─── Administração — painel privado de produtos e estoque ────────────
# Crie credenciais locais em .env.local. Em produção, use secrets do servidor.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# ─── Inspire AI (agente de conversa) ─────────────────────────────────
# Chave da API Anthropic (console.anthropic.com). SEM ela o site continua
# funcionando: a aba de conversa simplesmente não aparece e o orçamento
# segue pelo formulário.
ANTHROPIC_API_KEY=""

# Modelo. claude-sonnet-5 é o equilíbrio recomendado para chat com cliente.
# Para baratear, claude-haiku-4-5-20251001 costuma dar conta deste fluxo.
INSPIRE_AI_MODEL="claude-sonnet-5"

# Fase 5 — E-commerce
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
