// Espelho do esquema SQL existente em src/lib/db.ts. Nenhuma tabela é renomeada
// nesta etapa. CHECK constraints e índices SQL permanecem na migração baseline.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model InventoryMaterial {
  id              String              @id
  name            String
  sku             String?             @unique
  category        String
  unit            String
  quantity        Decimal             @default(0) @db.Decimal(14, 3)
  unitCost        Decimal             @default(0) @map("unit_cost") @db.Decimal(14, 4)
  minimumQuantity Decimal             @default(0) @map("minimum_quantity") @db.Decimal(14, 3)
  archived        Boolean             @default(false)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  recipes         ProductMaterial[]
  movements       InventoryMovement[]

  @@map("inventory_materials")
}

model Product {
  id                         String                  @id
  slug                       String                  @unique
  name                       String
  shortDescription           String                  @map("short_description")
  description                String
  collection                 String
  category                   String
  productKind                String                  @default("physical") @map("product_kind")
  images                     Json                    @default("[]") @db.JsonB
  technicalCharacteristics   Json                    @default("[]") @map("technical_characteristics") @db.JsonB
  dimensions                 String?
  variants                   Json                    @default("[]") @db.JsonB
  personalizationOptions     Json                    @default("[]") @map("personalization_options") @db.JsonB
  price                      Decimal?                @db.Decimal(12, 2)
  availability               String                  @default("not-announced")
  launchStatus               String                  @default("in-development") @map("launch_status")
  leadTime                   String?                 @map("lead_time")
  estimatedLaborCost         Decimal                 @default(0) @map("estimated_labor_cost") @db.Decimal(12, 2)
  estimatedEnergyCost        Decimal                 @default(0) @map("estimated_energy_cost") @db.Decimal(12, 2)
  estimatedPackagingCost     Decimal                 @default(0) @map("estimated_packaging_cost") @db.Decimal(12, 2)
  estimatedOtherCost         Decimal                 @default(0) @map("estimated_other_cost") @db.Decimal(12, 2)
  estimatedTaxPercent        Decimal                 @default(0) @map("estimated_tax_percent") @db.Decimal(6, 3)
  estimatedPaymentFeePercent Decimal                 @default(0) @map("estimated_payment_fee_percent") @db.Decimal(6, 3)
  featured                   Boolean                 @default(false)
  published                  Boolean                 @default(false)
  finishedStock              Decimal                 @default(0) @map("finished_stock") @db.Decimal(14, 3)
  seoTitle                   String                  @map("seo_title")
  seoDescription             String                  @map("seo_description")
  createdAt                  DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  recipe                     ProductMaterial[]
  inventoryMovements         InventoryMovement[]
  saleItems                  SaleItem[]
  productionRuns             ProductionRun[]
  finishedStockMovements     FinishedStockMovement[]
  digitalOffers              DigitalOffer[]

  @@index([published, featured], map: "products_published_idx")
  @@map("products")
}

// Arquivos digitais ficam em objetos privados. A oferta é separada do produto
// para permitir licenças e preços diferentes sem duplicar a página de catálogo.
model DigitalOffer {
  id             String                @id
  productId      String                @map("product_id")
  family         String
  licenseCode    String                @map("license_code")
  licenseVersion String                @map("license_version")
  licenseText    String                @map("license_text")
  price          Decimal               @db.Decimal(12, 2)
  status         String                @default("draft")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  product        Product               @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assets         DigitalAssetVersion[]

  @@unique([productId, licenseCode], map: "digital_offers_product_license_key")
  @@index([status], map: "digital_offers_status_idx")
  @@map("digital_offers")
}

model DigitalAssetVersion {
  id          String       @id
  offerId     String       @map("offer_id")
  version     String
  format      String
  displayName String       @map("display_name")
  objectKey   String       @unique(map: "digital_asset_versions_object_key_key") @map("object_key")
  byteSize    BigInt       @map("byte_size")
  sha256      String       @db.Char(64)
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  offer       DigitalOffer @relation(fields: [offerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([offerId, active], map: "digital_asset_versions_offer_active_idx")
  @@map("digital_asset_versions")
}

model ProductMaterial {
  productId       String            @map("product_id")
  materialId      String            @map("material_id")
  quantityPerUnit Decimal           @map("quantity_per_unit") @db.Decimal(14, 3)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  material        InventoryMaterial @relation(fields: [materialId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([productId, materialId])
  @@map("product_materials")
}

model InventoryMovement {
  id            String            @id
  materialId    String            @map("material_id")
  kind          String
  quantityDelta Decimal           @map("quantity_delta") @db.Decimal(14, 3)
  unitCost      Decimal           @default(0) @map("unit_cost") @db.Decimal(14, 4)
  productId     String?           @map("product_id")
  note          String            @default("")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  material      InventoryMaterial @relation(fields: [materialId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product       Product?          @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "inventory_movements_created_at_idx")
  @@map("inventory_movements")
}

model InventoryPurchase {
  id           String   @id
  card         String
  store        String
  description  String
  category     String
  amount       Decimal  @db.Decimal(12, 2)
  installments Int
  source       String
  importedAt   DateTime @default(now()) @map("imported_at") @db.Timestamptz(6)

  @@map("inventory_purchases")
}

model Sale {
  id              String                  @id
  customerName    String                  @map("customer_name")
  customerContact String                  @default("") @map("customer_contact")
  channel         String
  status          String                  @default("draft")
  paymentStatus   String                  @default("pending") @map("payment_status")
  paymentMethod   String                  @default("") @map("payment_method")
  subtotal        Decimal                 @db.Decimal(12, 2)
  discount        Decimal                 @default(0) @db.Decimal(12, 2)
  shipping        Decimal                 @default(0) @db.Decimal(12, 2)
  total           Decimal                 @db.Decimal(12, 2)
  notes           String                  @default("")
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  confirmedAt     DateTime?               @map("confirmed_at") @db.Timestamptz(6)
  deliveredAt     DateTime?               @map("delivered_at") @db.Timestamptz(6)
  cancelledAt     DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  items           SaleItem[]
  productionRuns  ProductionRun[]
  stockMovements  FinishedStockMovement[]

  @@index([createdAt(sort: Desc)], map: "sales_created_at_idx")
  @@index([status], map: "sales_status_idx")
  @@map("sales")
}

model SaleItem {
  id               String   @id
  saleId           String   @map("sale_id")
  productId        String?  @map("product_id")
  nameSnapshot     String   @map("name_snapshot")
  fulfillment      String
  quantity         Int
  unitPrice        Decimal  @map("unit_price") @db.Decimal(12, 2)
  unitCostEstimate Decimal? @map("unit_cost_estimate") @db.Decimal(12, 2)
  sale             Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product          Product? @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([saleId], map: "sale_items_sale_idx")
  @@index([productId], map: "sale_items_product_idx")
  @@map("sale_items")
}

model ProductionRun {
  id           String   @id
  productId    String   @map("product_id")
  quantity     Decimal  @db.Decimal(14, 3)
  materialCost Decimal  @default(0) @map("material_cost") @db.Decimal(12, 2)
  note         String   @default("")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  saleId       String?  @map("sale_id")
  product      Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale         Sale?    @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("production_runs")
}

model FinishedStockMovement {
  id            String   @id
  productId     String   @map("product_id")
  saleId        String?  @map("sale_id")
  kind          String
  quantityDelta Int      @map("quantity_delta")
  note          String   @default("")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product       Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sale          Sale?    @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("finished_stock_movements")
}
